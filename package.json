{
  "name": "compiler-notebook",
  "displayName": "Compiler Notebook",
  "description": "Jupyter-like notebooks for compiled languages (C++, Rust, Zig)",
  "version": "0.0.9",
  "license": "MIT",
  "publisher": "andreysigorskikh",
  "private": true,
  "repository": {
    "type": "git",
    "url": "https://github.com/AndrewSigorskih/compiler-notebook.git"
  },
  "engines": {
    "vscode": "^1.90.0"
  },
  "categories": [
    "Notebooks",
    "Programming Languages"
  ],
  "main": "./out/extension.js",
  "activationEvents": [
    "onNotebook:compiler-notebook"
  ],
  "contributes": {
    "commands": [
      {
        "command": "compilerNotebook.renameFileCell",
        "title": "Rename File Cell",
        "category": "Compiler Notebook"
      },
      {
        "command": "compilerNotebook.newProject",
        "title": "New Project (Buildspec Cell)",
        "category": "Compiler Notebook"
      }
    ],
    "notebooks": [
      {
        "type": "compiler-notebook",
        "displayName": "Compiler Notebook",
        "selector": [
          {
            "filenamePattern": "*.cnb"
          }
        ]
      }
    ]
  },
  "scripts": {
    "compile": "tsc -p ./",
    "watch": "tsc -watch -p ./",
    "vscode:prepublish": "npm run compile",
    "package": "npx --yes @vscode/vsce package --skip-license",
    "test": "node --test out/test/*.test.js",
    "pretest": "npm run compile"
  },
  "devDependencies": {
    "@types/node": "^20.14.0",
    "@types/vscode": "^1.90.0",
    "typescript": "^5.5.4"
  }
}
